{
  "name": "den-braille-typewriter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.3.3",
    "fp-ts": "^2.16.2",
    "gh-pages": "^6.3.0",
    "immutable": "^5.0.0-beta.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "use-sound": "^4.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:vite": "vite",
    "build": "node scripts/build-legacy.mjs",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false && node --test scripts/*.test.mjs",
    "lint:baseline": "node scripts/check-lint-baseline.mjs",
    "audit:baseline": "node scripts/check-audit-baseline.mjs",
    "ci": "npm run lint:baseline && npm run test:ci && npm run build && npm run audit:baseline",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@vitejs/plugin-react": "^6.1.1",
    "jest": "^27.5.1",
    "typescript": "^4.9.5",
    "vite": "^8.2.2"
  },
  "homepage": "https://davidgomesh.github.io/den-braille-typewriter"
}
