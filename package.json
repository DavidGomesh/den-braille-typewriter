{
    "name": "den-braille-typewriter",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.5.1",
        "@fortawesome/free-brands-svg-icons": "^6.5.1",
        "@fortawesome/free-regular-svg-icons": "^6.5.1",
        "@fortawesome/free-solid-svg-icons": "^6.5.1",
        "@fortawesome/react-fontawesome": "^0.2.0",
        "@popperjs/core": "^2.11.8",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "bootstrap": "^5.3.3",
        "fp-ts": "^2.16.2",
        "immutable": "^5.0.0-beta.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.22.3",
        "use-sound": "^4.0.1"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build && node scripts/prepare-pages.mjs",
        "preview": "vite preview",
        "format": "prettier --check .",
        "lint": "node scripts/check-lint-baseline.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:ci": "vitest run && node --test scripts/*.test.mjs",
        "audit": "node scripts/check-audit-baseline.mjs",
        "ci": "npm run format && npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run audit"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^8.56.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-testing-library": "^5.11.1",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.6",
        "typescript": "^4.9.5",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "homepage": "https://davidgomesh.github.io/den-braille-typewriter"
}
